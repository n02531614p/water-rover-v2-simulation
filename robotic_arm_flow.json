  {
    "id": "angle_command",
    "type": "function",
    "z": "arm_tab",
    "name": "Format Angle Command",
    "func": "let angle = Number(msg.payload);\nif (!Number.isFinite(angle)) return null;\nangle = Math.max(0, Math.min(90, Math.round(angle)));\nmsg.payload = 'ANGLE:' + angle;\nmsg.topic = 'arm_command';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 120,
    "wires": [
      [
        "serial_command",
        "angle_display"
      ]
    ]
  },
  {
    "id": "serial_command",
    "type": "debug",
    "z": "arm_tab",
    "name": "Arm Command Preview",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 700,
    "y": 240,
    "wires": []
  },
  {
    "id": "angle_display",
