  {
    "id": "arm_comment",
    "type": "comment",
    "z": "arm_tab",
    "name": "Commands go to the ESP32 over MQTT rover/arm/cmd (EXTEND | RETRACT | ANGLE:n)",
    "info": "For a USB bench test with robotic_arm.ino instead, swap the mqtt out for a serial out (9600 baud).",
    "x": 460,
    "y": 340,
    "wires": []
  },
  {
