  {
    "id": "angle_command",
    "type": "function",
    "z": "arm_tab",
    "name": "Format Angle Command",
    "func": "let angle = Number(msg.payload);\nif (!Number.isFinite(angle)) return null;\nangle = Math.max(0, Math.min(90, Math.round(angle)));\nmsg.payload = 'ANGLE:' + angle;\nmsg.topic = 'arm_command';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 120,
    "wires": [
      [
        "serial_command",
        "angle_display",
        "arm_cmd_preview"
      ]
    ]
  },
  {
    "id": "serial_command",
    "type": "mqtt out",
    "z": "arm_tab",
    "name": "rover/arm/cmd",
    "topic": "rover/arm/cmd",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "wd_broker",
    "x": 640,
    "y": 160,
    "wires": []
  },
  {
