{
  "description": "Water-flow sensor YF-S401 (hall turbine, ~5880 pulses/L, 0.3-6 L/min) on the intake line. Counts pulses on PORT by interrupt. TOT = mL since boot, BAT = mL since RST (use as the intake fill), RATE = mL/s, DRY = no pulse for DRYT seconds (pump on + DRY = dry run / blocked hose).",
  "nodes": [
    {
      "id": "in00",
      "type": "xod/patch-nodes/input-number",
      "position": {
        "x": 0,
        "y": 0
      },
      "label": "PORT",
      "boundLiterals": {
        "__out__": "34"
      }
    },
    {
      "id": "in01",
      "type": "xod/patch-nodes/input-number",
      "position": {
        "x": 102,
        "y": 0
      },
      "label": "PPL",
      "boundLiterals": {
        "__out__": "5880"
      },
      "description": "pulses per litre: YF-S401 ~5880 (calibrate with 1 L)"
    },
    {
      "id": "in02",
      "type": "xod/patch-nodes/input-pulse",
      "position": {
        "x": 204,
        "y": 0
      },
      "label": "RST",
      "boundLiterals": {
        "__out__": "Never"
      },
      "description": "reset the batch counter"
    },
    {
      "id": "in03",
      "type": "xod/patch-nodes/input-number",
      "position": {
        "x": 306,
        "y": 0
      },
      "label": "DRYT",
      "boundLiterals": {
