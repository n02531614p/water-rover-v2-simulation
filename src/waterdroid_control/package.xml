<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waterdroid_control</name>
  <version>0.1.0</version>
  <description>Waterdroid mission FSM (Issue #11), simulated treatment train (Issues #1 #3 #5 #8), delivery-arm controller (Issue #6) and status / Node-RED MQTT bridge (Issue #12)</description>
  <maintainer email="student@nust.ac.zw">student</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
