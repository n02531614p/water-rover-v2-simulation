<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waterdroid_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro model of the Waterdroid 4WD water-treatment rover (two-deck chassis, 3-stage treatment train, 4 pumps, SG90 delivery arm) with Gazebo Harmonic systems.</description>
  <maintainer email="student@nust.ac.zw">student</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
