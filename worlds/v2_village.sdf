<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="community_delivery_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene Lighting -->
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.5 0.7 1.0 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 0.98 0.9 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Terrain -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script>
            <ambient>0.3 0.6 0.2 1</ambient>
            <diffuse>0.35 0.65 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Community Water Well (x=7.0, y=0.0) -->
    <model name="water_well">
      <static>true</static>
      <pose>7.0 0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.8</radius><length>0.3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================= HOMESTEAD 1: Traditional Rondavel Hut ================= -->
    <model name="hut_1">
      <static>true</static><pose>3.0 4.0 0 0 0 0</pose>
      <link name="l">
        <!-- Cylinder Wall -->
        <visual name="wall"><geometry><cylinder><radius>1.2</radius><length>1.2</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <!-- Conical Thatch Roof -->
        <visual name="roof"><pose>0 0 0.9 0 0 0</pose><geometry><cone><radius>1.5</radius><length>0.8</length></cone></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>
    <model name="home_1">
      <static>true</static><pose>3.0 2.5 0.2 0 0 0</pose> <!-- Delivery Point -->
      <link name="l"><visual name="v"><geometry><box><size>0.6 0.6 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link>
    </model>

    <!-- ================= HOMESTEAD 2: Modern Brick House ================= -->
    <model name="house_2">
      <static>true</static><pose>5.0 4.0 0.6 0 0 0</pose>
      <link name="l">
        <visual name="walls"><geometry><box><size>2.2 2.8 1.2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="roof"><pose>0 0 0.8 0 0 0</pose><geometry><box><size>2.4 3.0 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>
    <model name="home_2">
      <static>true</static><pose>5.0 2.2 0.2 0 0 0</pose> <!-- Delivery Point -->
      <link name="l"><visual name="v"><geometry><box><size>0.6 0.6 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link>
    </model>

    <!-- ================= HOMESTEAD 3: Traditional Rondavel Hut ================= -->
    <model name="hut_3">
      <static>true</static><pose>4.0 -4.5 0 0 0 0</pose>
      <link name="l">
        <visual name="wall"><geometry><cylinder><radius>1.2</radius><length>1.2</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <visual name="roof"><pose>0 0 0.9 0 0 0</pose><geometry><cone><radius>1.5</radius><length>0.8</length></cone></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>
    <model name="home_3">
      <static>true</static><pose>4.0 -2.8 0.2 0 0 0</pose> <!-- Delivery Point -->
      <link name="l"><visual name="v"><geometry><box><size>0.6 0.6 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link>
    </model>

    <!-- ================= HOMESTEAD 4: Modern Brick House ================= -->
    <model name="house_4">
      <static>true</static><pose>-2.0 -4.2 0.6 0 0 0</pose>
      <link name="l">
        <visual name="walls"><geometry><box><size>2.2 2.6 1.2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="roof"><pose>0 0 0.8 0 0 0</pose><geometry><box><size>2.4 2.8 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>
    <model name="home_4">
      <static>true</static><pose>-2.0 -2.5 0.2 0 0 0</pose> <!-- Delivery Point -->
      <link name="l"><visual name="v"><geometry><box><size>0.6 0.6 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link>
    </model>

    <!-- ================= HOMESTEAD 5: Traditional Rondavel Hut ================= -->
    <model name="hut_5">
      <static>true</static><pose>-3.0 4.2 0 0 0 0</pose>
      <link name="l">
        <visual name="wall"><geometry><cylinder><radius>1.2</radius><length>1.2</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <visual name="roof"><pose>0 0 0.9 0 0 0</pose><geometry><cone><radius>1.5</radius><length>0.8</length></cone></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>
    <model name="home_5">
      <static>true</static><pose>-3.0 2.5 0.2 0 0 0</pose> <!-- Delivery Point -->
      <link name="l"><visual name="v"><geometry><box><size>0.6 0.6 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link>
    </model>

    <!-- Decorative Foliage (Trees around outer village boundary) -->
    <model name="tree_1">
      <static>true</static><pose>1.0 6.0 1.0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <visual name="foliage"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>1.0</radius></sphere></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static><pose>0.0 -6.0 1.0 0 0 0</pose>
      <link name="l">
        <visual name="trunk"><geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <visual name="foliage"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>1.0</radius></sphere></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>

  </world>
</sdf>
