#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 16
}

Viewpoint {
  orientation -0.20 0.25 0.95 2.0
  position 2 -12 8
}

Background {
  skyColor [ 0.4 0.7 1.0 ]
}
DirectionalLight {
  ambientIntensity 0.5
  direction -0.5 -0.8 -1
  intensity 1.2
  castShadows TRUE
}

# Ground Terrain with Collision
Solid {
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.35 0.55 0.25 roughness 0.9 }
      geometry Box { size 35 35 0.01 }
    }
  ]
  boundingObject Box { size 35 35 0.01 }
  name "ground"
}

# River Water Source
Solid {
  translation 10.0 0 0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.4 0.9 roughness 0.1 metalness 0.8 }
      geometry Box { size 2 12 0.1 }
    }
  ]
  name "river_intake"
}

# Plant Base Station
Solid {
  translation 0 0 0.02
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.7 0.3 roughness 0.5 }
      geometry Box { size 1.5 1.5 0.02 }
    }
  ]
  name "water_plant"
}

# Homestead Huts
Solid {
  translation -5.0 3.0 0
  children [
    Transform { translation 0 0 0.4 children [ Shape { appearance PBRAppearance { baseColor 0.85 0.75 0.6 } geometry Cylinder { radius 0.7 height 0.8 } } ] }
    Transform { translation 0 0 1.05 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.35 0.15 } geometry Cone { bottomRadius 0.95 height 0.6 } } ] }
  ]
  name "home_1"
}

Solid {
  translation -5.0 -0.5 0
  children [
    Transform { translation 0 0 0.4 children [ Shape { appearance PBRAppearance { baseColor 0.85 0.75 0.6 } geometry Cylinder { radius 0.7 height 0.8 } } ] }
    Transform { translation 0 0 1.05 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.35 0.15 } geometry Cone { bottomRadius 0.95 height 0.6 } } ] }
  ]
  name "home_2"
}

Solid {
  translation -5.0 -3.0 0
  children [
    Transform { translation 0 0 0.4 children [ Shape { appearance PBRAppearance { baseColor 0.85 0.75 0.6 } geometry Cylinder { radius 0.7 height 0.8 } } ] }
    Transform { translation 0 0 1.05 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.35 0.15 } geometry Cone { bottomRadius 0.95 height 0.6 } } ] }
  ]
  name "home_3"
}

# Side Trees
Solid {
  translation 2.0 7.0 0
  children [
    Transform { translation 0 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.4 0.25 0.1 } geometry Cylinder { radius 0.18 height 1.5 } } ] }
    Transform { translation 0 0 2.0 children [ Shape { appearance PBRAppearance { baseColor 0.15 0.45 0.15 } geometry Cone { bottomRadius 1.2 height 2.0 } } ] }
  ]
  name "tree_left_1"
}

Solid {
  translation 7.0 7.5 0
  children [
    Transform { translation 0 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.4 0.25 0.1 } geometry Cylinder { radius 0.2 height 1.5 } } ] }
    Transform { translation 0 0 2.2 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.4 0.1 } geometry Cone { bottomRadius 1.4 height 2.2 } } ] }
  ]
  name "tree_left_2"
}

Solid {
  translation -3.0 7.2 0
  children [
    Transform { translation 0 0 0.6 children [ Shape { appearance PBRAppearance { baseColor 0.4 0.25 0.1 } geometry Cylinder { radius 0.15 height 1.2 } } ] }
    Transform { translation 0 0 1.7 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.5 0.2 } geometry Cone { bottomRadius 1.1 height 1.8 } } ] }
  ]
  name "tree_left_3"
}

Solid {
  translation 2.0 -7.0 0
  children [
    Transform { translation 0 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.4 0.25 0.1 } geometry Cylinder { radius 0.18 height 1.5 } } ] }
    Transform { translation 0 0 2.0 children [ Shape { appearance PBRAppearance { baseColor 0.15 0.45 0.15 } geometry Cone { bottomRadius 1.2 height 2.0 } } ] }
  ]
  name "tree_right_1"
}

# Dynamic 4WD Robot with Compass and Clean Physics
Robot {
  translation 0 0 0.12
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.2 0.2 roughness 0.3 }
      geometry Box { size 0.5 0.35 0.08 }
    }
    Transform {
      translation -0.05 0 0.10
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.6 1.0 roughness 0.1 transparency 0.2 }
          geometry Cylinder { radius 0.12 height 0.14 }
        }
      ]
    }
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }

    # FRONT LEFT
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.15 0.20 0 }
      device [ RotationalMotor { name "front_left_motor" } ]
      endPoint Solid {
        translation 0.15 0.20 0
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.9 0.4 0.0 } geometry Cylinder { radius 0.07 height 0.04 } } ]
        boundingObject Cylinder { radius 0.07 height 0.04 }
        physics Physics { mass 0.1 density -1 }
        name "front_left_wheel"
      }
    }

    # REAR LEFT
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.15 0.20 0 }
      device [ RotationalMotor { name "left wheel motor" } ]
      endPoint Solid {
        translation -0.15 0.20 0
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.9 0.4 0.0 } geometry Cylinder { radius 0.07 height 0.04 } } ]
        boundingObject Cylinder { radius 0.07 height 0.04 }
        physics Physics { mass 0.1 density -1 }
        name "rear_left_wheel"
      }
    }

    # FRONT RIGHT
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.15 -0.20 0 }
      device [ RotationalMotor { name "front_right_motor" } ]
      endPoint Solid {
        translation 0.15 -0.20 0
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.9 0.4 0.0 } geometry Cylinder { radius 0.07 height 0.04 } } ]
        boundingObject Cylinder { radius 0.07 height 0.04 }
        physics Physics { mass 0.1 density -1 }
        name "front_right_wheel"
      }
    }

    # REAR RIGHT
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.15 -0.20 0 }
      device [ RotationalMotor { name "right wheel motor" } ]
      endPoint Solid {
        translation -0.15 -0.20 0
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.9 0.4 0.0 } geometry Cylinder { radius 0.07 height 0.04 } } ]
        boundingObject Cylinder { radius 0.07 height 0.04 }
        physics Physics { mass 0.1 density -1 }
        name "rear_right_wheel"
      }
    }
  ]
  boundingObject Box { size 0.5 0.35 0.08 }
  physics Physics { mass 2.0 density -1 }
  name "waterdroid"
  controller "waterdroid_controller"
}
